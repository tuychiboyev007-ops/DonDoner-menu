# DonDoner bot sozlamalari
# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# ⚠️ .env fayl HECH QACHON git'ga tushmasligi kerak (.gitignore'da bor).

# BotFather bergan token
BOT_TOKEN=123456:ABC-YOUR-TOKEN-HERE

# Mini App manzili (GitHub Pages, https bo'lishi shart)
WEBAPP_URL=https://username.github.io/DonDoner-menu/

# Buyurtmalar yuboriladigan chat (sizning Telegram ID yoki guruh ID).
# O'z ID'ingizni bilish uchun: @userinfobot ga /start yozing.
ADMIN_CHAT_ID=123456789
