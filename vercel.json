{
  "builds": [
    {
      "src": "api/webhook.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "api/_store.py"
      }
    },
    {
      "src": "api/orders.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "api/_store.py"
      }
    },
    {
      "src": "api/geocode.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "api/_store.py"
      }
    },
    {
      "src": "api/order.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "api/_store.py"
      }
    },
    {
      "src": "api/myorders.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "api/_store.py"
      }
    },
    {
      "src": "api/menu.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "api/_store.py"
      }
    },
    {
      "src": "api/admin.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "api/_store.py"
      }
    },
    {
      "src": "{index.html,admin.html,css/**,js/**,data/**,images/**,vendor/**}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/api/orders",
      "dest": "/api/orders.py"
    },
    {
      "src": "/api/geocode(\\?.*)?",
      "dest": "/api/geocode.py"
    },
    {
      "src": "/api/order",
      "dest": "/api/order.py"
    },
    {
      "src": "/api/myorders",
      "dest": "/api/myorders.py"
    },
    {
      "src": "/api/menu",
      "dest": "/api/menu.py"
    },
    {
      "src": "/api/admin",
      "dest": "/api/admin.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
